generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  caregiver
  viewer
}

enum EventCategory {
  nebulizer_treatment
  medication
  meal
  hydration
  mood_behavior
  vitals
  toileting
  sleep
  activity
  incident
  observation_other
}

enum EventStatus {
  pending_ai
  needs_review
  confirmed
  ai_failed
}

enum AttachmentKind {
  photo
  audio
}

enum ScheduleStatus {
  active
  paused
}

enum NotifChannel {
  push
  sms
  in_app
}

enum NotifDelivery {
  sent
  logged_only
  failed
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  phone         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  accounts    Account[]
  sessions    Session[]
  assignments CaregiverAssignment[]
  events      CareEvent[]           @relation("author")

  @@map("users")
}

model Patient {
  id           String    @id @default(uuid())
  name         String
  dateOfBirth  DateTime? @map("date_of_birth")
  medicalNotes String?   @map("medical_notes")
  medications  Json?     @map("medications")
  createdAt    DateTime  @default(now()) @map("created_at")

  assignments CaregiverAssignment[]
  events      CareEvent[]
  schedules   Schedule[]
  templates   Template[]

  @@map("patients")
}

model CaregiverAssignment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  patientId String    @map("patient_id")
  role      Role
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user    User    @relation(fields: [userId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([userId, patientId])
  @@map("caregiver_assignments")
}

model CareEvent {
  id              String        @id
  patientId       String        @map("patient_id")
  authorId        String        @map("author_id")
  category        EventCategory?
  status          EventStatus   @default(pending_ai)

  occurredAt      DateTime      @map("occurred_at")
  capturedAt      DateTime      @map("captured_at")

  rawInput        String?       @map("raw_input")
  structuredData  Json?         @map("structured_data")
  aiConfidence    Float?        @map("ai_confidence")
  aiFlags         String[]      @map("ai_flags")
  aiModelVersion  String?       @map("ai_model_version")
  scheduleId      String?       @map("schedule_id")

  templateId      String?       @map("template_id")
  hasConflict     Boolean       @default(false) @map("has_conflict")

  version         Int           @default(1)
  clientId        String        @map("client_id")
  idempotencyKey  String        @unique @map("idempotency_key")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  deletedAt       DateTime?     @map("deleted_at")

  patient     Patient     @relation(fields: [patientId], references: [id])
  author      User        @relation("author", fields: [authorId], references: [id])
  template    Template?   @relation(fields: [templateId], references: [id])
  schedule    Schedule?   @relation(fields: [scheduleId], references: [id])
  attachments Attachment[]

  @@index([patientId, occurredAt])
  @@index([patientId, updatedAt])
  @@index([patientId, category, occurredAt])
  @@map("care_events")
}

model Attachment {
  id            String         @id
  eventId       String         @map("event_id")
  kind          AttachmentKind
  storageKey    String         @map("storage_key")
  mimeType      String         @map("mime_type")
  sizeBytes     Int?           @map("size_bytes")
  uploadedAt    DateTime?      @map("uploaded_at")
  transcript    String?
  visionSummary String?        @map("vision_summary")
  createdAt     DateTime       @default(now()) @map("created_at")

  event CareEvent @relation(fields: [eventId], references: [id])

  @@map("attachments")
}

model Template {
  id        String        @id @default(uuid())
  patientId String        @map("patient_id")
  name      String
  category  EventCategory
  defaults  Json
  icon      String?
  createdBy String        @map("created_by")
  isActive  Boolean       @default(true) @map("is_active")
  updatedAt DateTime      @updatedAt @map("updated_at")
  createdAt DateTime      @default(now()) @map("created_at")

  patient Patient     @relation(fields: [patientId], references: [id])
  events  CareEvent[]

  @@map("templates")
}

model Schedule {
  id            String         @id @default(uuid())
  patientId     String         @map("patient_id")
  templateId    String?        @map("template_id")
  name          String
  rrule         String
  windowMinutes Int            @default(90) @map("window_minutes")
  remindOffsets Int[]          @default([0]) @map("remind_offsets")
  escalation    Json?
  status        ScheduleStatus @default(active)
  updatedAt     DateTime       @updatedAt @map("updated_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  patient Patient     @relation(fields: [patientId], references: [id])
  events  CareEvent[]

  @@map("schedules")
}

model Notification {
  id             String         @id @default(uuid())
  scheduleId     String?        @map("schedule_id")
  userId         String         @map("user_id")
  channel        NotifChannel
  deliveryStatus NotifDelivery? @map("delivery_status")
  title          String
  body           String
  dueAt          DateTime       @map("due_at")
  sentAt         DateTime?      @map("sent_at")
  acknowledgedAt DateTime?      @map("acknowledged_at")
  escalatedAt    DateTime?      @map("escalated_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([scheduleId, dueAt])
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String   @map("actor_type")
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")
  clientId   String?  @map("client_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}
