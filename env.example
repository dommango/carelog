# CareLog environment variables.
# Copy to apps/web/.env.local (web) and apps/worker/.env (worker); packages/db/.env
# needs only DATABASE_URL. Everything not marked required degrades gracefully when unset.
# (Named env.example without a leading dot so it is never matched by .env* ignore rules.)

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection (dev convention: port 5436).
DATABASE_URL=postgresql://carelog:carelog@localhost:5436/carelog
# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=
# Root directory for uploaded media (photos, voice memos).
STORAGE_ROOT=./storage

# ── Auth (optional providers) ───────────────────────────────────────────────
# Auth.js infers the origin from the request (trustHost); set only if inference fails.
AUTH_URL=
# Google sign-in — both required to enable the provider; unset hides it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic-link (SMTP) — both required to enable the provider.
EMAIL_SERVER=
EMAIL_FROM=

# ── Access control (IMPORTANT for public deployments) ───────────────────────
# Comma-separated allowlist of sign-in emails. UNSET MEANS OPEN SIGN-UP: anyone
# who authenticates with a configured provider can create an account and onboard
# their own care circle. Set this on any internet-reachable deployment.
ALLOWED_SIGNIN_EMAILS=

# ── AI pipeline (worker) ────────────────────────────────────────────────────
# Unset → events stay pending/ai_failed with raw input intact; the app still works.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Notifications (optional; unset → rows logged with deliveryStatus=logged_only)
# Web push — generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── URLs ────────────────────────────────────────────────────────────────────
# Externally reachable origin (used for links and Notion-fetched screenshot URLs).
APP_BASE_URL=
# Public base URL media is served from; derived from the app origin when unset.
STORAGE_BASE_URL=

# ── Feedback → Notion mirror (optional; see FEEDBACK.md) ────────────────────
NOTION_API_KEY=
NOTION_FEEDBACK_DB_ID=

# ── Operational secrets ─────────────────────────────────────────────────────
# Shared secret for the reconciler cron route (must match on web and worker).
CRON_SECRET=
# Guards /api/auth/test-login outside development. The route refuses outright in
# production regardless of this value. NEVER set this in production.
TEST_LOGIN_SECRET=
